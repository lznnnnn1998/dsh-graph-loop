{
  "name": "dsh-graph-loop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "e2e": "bash scripts/e2e-headless.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
