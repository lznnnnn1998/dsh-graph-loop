{
  "name": "@dsh/explore-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bundle A of the explore work: a fifth agent-preset mode over the stock agent loop, with a graph policy section and an idle-teammate reuse guard.",
