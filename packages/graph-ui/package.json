{
  "name": "dsh-graph-loop-ui",
  "version": "0.1.1",
  "type": "module",
  "description": "Web surface for dsh-graph-loop: the Graph tab in the DSH conversation view and /graph-chat API.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "engines": {
    "dsh": "^0.2.1-rc.3"
  },
  "license": "MIT",
  "author": "lzn1998",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lznnnnn1998/dsh-graph-loop.git"
  },
  "homepage": "https://github.com/lznnnnn1998/dsh-graph-loop#readme",
  "bugs": {
    "url": "https://github.com/lznnnnn1998/dsh-graph-loop/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "client-plugin",
    "graph",
    "visualization"
  ]
}
