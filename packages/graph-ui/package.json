{
  "name": "@dsh/explore-graph-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Graph tab for the DSH Web conversation view: per-turn topology next to Chat and Trajectory.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/graph-view.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "client"],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  }
}
